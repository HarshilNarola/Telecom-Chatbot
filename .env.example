# Copy this file to .env and replace the placeholders.
# Required for the LLM: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to a model available through Groq.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional, but recommended for Hugging Face model downloads:
# https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
